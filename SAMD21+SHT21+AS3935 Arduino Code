// ============================================================
// VIGILIS Outdoor Sensor Node V2.1
// XIAO SAMD21 + SHT31 + DFRobot Gravity AS3935
//
// SENSOR:
// D2 = AS3935 IRQ
// D4 = SDA -> SHT31 + AS3935
// D5 = SCL -> SHT31 + AS3935
//
// RASPBERRY PI:
// D6 / TX -> Raspberry Pi GPIO13 / physical Pin 33
// D7 / RX <- Raspberry Pi GPIO26 / physical Pin 37
//
// USB Serial = 115200 baud
// Pi UART    = 9600 baud
// ============================================================


// ============================================================
// PIN CONFIG
// ============================================================

#define AS3935_IRQ_PIN D2
#define PI_RX_PIN      D7


// ============================================================
// AS3935 CONSTANTS
// ============================================================

#define AS3935_I2C_ADDR AS3935_ADD3   // 0x03

#define AS3935_INDOORS  0
#define AS3935_OUTDOORS 1

#define AS3935_DIST_DIS 0
#define AS3935_DIST_EN  1


// ============================================================
// AS3935 DEFAULT SETTINGS
// ============================================================
//
// Previously measured:
//
// 120 pF -> approx. 503.62 kHz
//
// Settings are NOT persistent yet.
// After power cycle these defaults are restored.
// ============================================================

uint8_t as3935Capacitance = 120;

uint8_t as3935Mode =
  AS3935_OUTDOORS;

uint8_t as3935Disturber =
  AS3935_DIST_EN;

uint8_t as3935NoiseFloor = 0;

uint8_t as3935Watchdog = 1;

uint8_t as3935Spike = 1;


// ============================================================
// STARTUP CONFIG
// ============================================================
//
// IMPORTANT:
// The 5 second delay fixes the reproducible AS3935
// common cold-start problem.
//
// Tested:
// XIAO + AS3935 powered simultaneously -> 3/3 successful.
// ============================================================

#define AS3935_POWERUP_DELAY_MS 5000

#define AS3935_RETRY_DELAY_MS 2000

#define AS3935_MAX_RETRIES 5


// ============================================================
// ENVIRONMENT CONFIG
// ============================================================

const unsigned long ENV_INTERVAL =
  5000;

unsigned long lastEnvironmentSend =
  0;


// ============================================================
// SENSOR OBJECTS
// ============================================================

Adafruit_SHT31 sht31 =
  Adafruit_SHT31();


DFRobot_AS3935_I2C lightning(
  (uint8_t)AS3935_IRQ_PIN,
  (uint8_t)AS3935_I2C_ADDR
);


// ============================================================
// SENSOR STATUS
// ============================================================

volatile bool as3935Interrupt =
  false;


bool sht31Online =
  false;

bool as3935Online =
  false;

bool sht31Heater =
  false;


// ============================================================
// EVENT COUNTERS
// ============================================================

uint32_t lightningCount =
  0;

uint32_t emiEventCount =
  0;

uint32_t noiseCount =
  0;

uint32_t unknownIrqCount =
  0;


// ============================================================
// COMMAND BUFFERS
// ============================================================

String usbCommand = "";

String piCommand = "";


// ============================================================
// IRQ HANDLER
// ============================================================

void AS3935_ISR()
{
  as3935Interrupt = true;
}


// ============================================================
// COMMAND RESPONSE
// ============================================================
//
// USB command:
// response only on USB.
//
// Raspberry command:
// response goes back through D6/TX.
// A copy is also printed on USB for diagnostics.
// ============================================================

void commandResponse(
  const String &text,
  bool fromPi
)
{
  if (fromPi)
  {
    Serial1.println(text);

    Serial.print("[PI] ");
    Serial.println(text);
  }
  else
  {
    Serial.println(text);
  }
}


// ============================================================
// SEND ENVIRONMENT DATA TO PI
// ============================================================

void sendEnvironment()
{
  if (!sht31Online)
  {
    return;
  }


  float temperature =
    sht31.readTemperature();


  float humidity =
    sht31.readHumidity();


  if (
    !isnan(temperature) &&
    !isnan(humidity)
  )
  {
    Serial1.print(
      "ENV,T="
    );

    Serial1.print(
      temperature,
      2
    );


    Serial1.print(
      ",H="
    );

    Serial1.println(
      humidity,
      2
    );
  }
  else
  {
    Serial1.println(
      "ERROR,SHT31_READ"
    );


    Serial.println(
      "SHT31 read error."
    );
  }
}


// ============================================================
// APPLY AS3935 SETTINGS
// ============================================================

void applyAS3935Settings()
{
  Serial.println(
    "Applying antenna calibration..."
  );


  lightning.manualCal(
    as3935Capacitance,
    as3935Mode,
    as3935Disturber
  );


  delay(250);


  Serial.println(
    "Applying sensitivity settings..."
  );


  lightning.setNoiseFloorLvl(
    as3935NoiseFloor
  );


  lightning.setWatchdogThreshold(
    as3935Watchdog
  );


  lightning.setSpikeRejection(
    as3935Spike
  );


  delay(250);
}


// ============================================================
// INITIALIZE AS3935
// ============================================================

bool initializeAS3935()
{
  Serial.println();

  Serial.println(
    "================================="
  );

  Serial.println(
    " AS3935 INITIALIZATION"
  );

  Serial.println(
    "================================="
  );


  // ----------------------------------------------------------
  // Disable IRQ during initialization
  // ----------------------------------------------------------

  detachInterrupt(
    digitalPinToInterrupt(
      AS3935_IRQ_PIN
    )
  );


  as3935Interrupt =
    false;


  as3935Online =
    false;


  // ----------------------------------------------------------
  // Detect sensor
  // ----------------------------------------------------------

  bool detected =
    false;


  for (
    uint8_t attempt = 1;
    attempt <= AS3935_MAX_RETRIES;
    attempt++
  )
  {
    Serial.print(
      "AS3935 begin attempt "
    );


    Serial.print(
      attempt
    );


    Serial.print(
      "/"
    );


    Serial.print(
      AS3935_MAX_RETRIES
    );


    Serial.print(
      ": "
    );


    if (
      lightning.begin() == 0
    )
    {
      Serial.println(
        "OK"
      );


      detected =
        true;


      break;
    }


    Serial.println(
      "NOT FOUND"
    );


    Serial1.println(
      "STATUS,AS3935=OFFLINE"
    );


    delay(
      AS3935_RETRY_DELAY_MS
    );
  }


  // ----------------------------------------------------------
  // Detection failed
  // ----------------------------------------------------------

  if (!detected)
  {
    Serial.println();


    Serial.println(
      "*** AS3935 INITIALIZATION FAILED ***"
    );


    Serial1.println(
      "STATUS,AS3935=OFFLINE"
    );


    as3935Online =
      false;


    return false;
  }


  // ----------------------------------------------------------
  // Allow chip to settle
  // ----------------------------------------------------------

  delay(250);


  // ----------------------------------------------------------
  // Reset registers
  // ----------------------------------------------------------

  Serial.println(
    "Applying default configuration..."
  );


  lightning.defInit();


  delay(250);


  // ----------------------------------------------------------
  // Apply VIGILIS configuration
  // ----------------------------------------------------------

  applyAS3935Settings();


  // ----------------------------------------------------------
  // Configure IRQ
  // ----------------------------------------------------------

  pinMode(
    AS3935_IRQ_PIN,
    INPUT
  );


  // Clear/read any pending source before enabling IRQ.

  uint8_t pendingSource =
    lightning.getInterruptSrc();


  Serial.print(
    "Initial interrupt source: "
  );


  Serial.println(
    pendingSource
  );


  as3935Interrupt =
    false;


  attachInterrupt(
    digitalPinToInterrupt(
      AS3935_IRQ_PIN
    ),
    AS3935_ISR,
    RISING
  );


  // ----------------------------------------------------------
  // Sensor online
  // ----------------------------------------------------------

  as3935Online =
    true;


  Serial1.println(
    "STATUS,AS3935=ONLINE"
  );


  Serial.println();

  Serial.println(
    "*** AS3935 READY ***"
  );

  Serial.println();


  return true;
}


// ============================================================
// MACHINE STATUS RESPONSE
// ============================================================

String buildStatus()
{
  String msg =
    "STATUS,NODE=ONLINE";


  msg +=
    ",SHT31=";


  msg +=
    sht31Online
      ? "ONLINE"
      : "OFFLINE";


  msg +=
    ",AS3935=";


  msg +=
    as3935Online
      ? "ONLINE"
      : "OFFLINE";


  msg +=
    ",HEATER=";


  msg +=
    sht31Heater
      ? "ON"
      : "OFF";


  return msg;
}


// ============================================================
// MACHINE COUNTER RESPONSE
// ============================================================

String buildCounters()
{
  String msg =
    "COUNTERS,LIGHTNING=";


  msg +=
    String(
      lightningCount
    );


  msg +=
    ",EMI=";


  msg +=
    String(
      emiEventCount
    );


  msg +=
    ",NOISE=";


  msg +=
    String(
      noiseCount
    );


  msg +=
    ",UNKNOWN=";


  msg +=
    String(
      unknownIrqCount
    );


  return msg;
}


// ============================================================
// MACHINE AS3935 RESPONSE
// ============================================================

String buildAS3935Config()
{
  String msg =
    "AS3935,ONLINE=";


  msg +=
    as3935Online
      ? "1"
      : "0";


  msg +=
    ",MODE=";


  msg +=
    (
      as3935Mode ==
      AS3935_OUTDOORS
    )
      ? "OUTDOOR"
      : "INDOOR";


  msg +=
    ",CAP=";


  msg +=
    String(
      as3935Capacitance
    );


  msg +=
    ",NOISE=";


  msg +=
    String(
      as3935NoiseFloor
    );


  msg +=
    ",WATCHDOG=";


  msg +=
    String(
      as3935Watchdog
    );


  msg +=
    ",SPIKE=";


  msg +=
    String(
      as3935Spike
    );


  msg +=
    ",DISTURBER=";


  msg +=
    as3935Disturber
      ? "ON"
      : "OFF";


  return msg;
}


