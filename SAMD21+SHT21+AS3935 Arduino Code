// ============================================================
// COMMAND PROCESSOR
// ============================================================

void processCommand(
  String cmd,
  bool fromPi
)
{
  cmd.trim();

  cmd.toUpperCase();


  if (
    cmd.length() == 0
  )
  {
    return;
  }


  // ==========================================================
  // PING
  // ==========================================================

  if (
    cmd == "PING"
  )
  {
    commandResponse(
      "PONG",
      fromPi
    );
  }


  // ==========================================================
  // GET STATUS
  // ==========================================================

  else if (
    cmd == "GET STATUS" ||
    cmd == "GET,STATUS"
  )
  {
    if (fromPi)
    {
      commandResponse(
        buildStatus(),
        true
      );
    }
    else
    {
      printUSBStatus();
    }
  }


  // ==========================================================
  // GET COUNTERS
  // ==========================================================

  else if (
    cmd == "GET COUNTERS" ||
    cmd == "GET,COUNTERS" ||
    cmd == "STATS"
  )
  {
    if (fromPi)
    {
      commandResponse(
        buildCounters(),
        true
      );
    }
    else
    {
      printUSBCounters();
    }
  }


  // ==========================================================
  // GET AS3935
  // ==========================================================

  else if (
    cmd == "GET AS3935" ||
    cmd == "GET,AS3935"
  )
  {
    if (fromPi)
    {
      commandResponse(
        buildAS3935Config(),
        true
      );
    }
    else
    {
      printUSBAS3935();
    }
  }


  // ==========================================================
  // REINITIALIZE AS3935
  // ==========================================================

  else if (
    cmd == "REINIT AS3935" ||
    cmd == "REINIT,AS3935"
  )
  {
    commandResponse(
      "ACK,AS3935,REINIT",
      fromPi
    );


    initializeAS3935();
  }


  // ==========================================================
  // SET NOISE FLOOR
  // ==========================================================

  else if (
    cmd.startsWith(
      "SET,AS3935,NOISE="
    )
  )
  {
    int value =
      cmd.substring(
        strlen(
          "SET,AS3935,NOISE="
        )
      ).toInt();


    if (
      value >= 0 &&
      value <= 7
    )
    {
      as3935NoiseFloor =
        (uint8_t)value;


      lightning.setNoiseFloorLvl(
        as3935NoiseFloor
      );


      commandResponse(
        "ACK,AS3935,NOISE=" +
        String(
          as3935NoiseFloor
        ),
        fromPi
      );
    }
    else
    {
      commandResponse(
        "ERR,AS3935,NOISE,RANGE",
        fromPi
      );
    }
  }


  // ==========================================================
  // SET WATCHDOG
  // ==========================================================

  else if (
    cmd.startsWith(
      "SET,AS3935,WATCHDOG="
    )
  )
  {
    int value =
      cmd.substring(
        strlen(
          "SET,AS3935,WATCHDOG="
        )
      ).toInt();


    if (
      value >= 0 &&
      value <= 15
    )
    {
      as3935Watchdog =
        (uint8_t)value;


      lightning.setWatchdogThreshold(
        as3935Watchdog
      );


      commandResponse(
        "ACK,AS3935,WATCHDOG=" +
        String(
          as3935Watchdog
        ),
        fromPi
      );
    }
    else
    {
      commandResponse(
        "ERR,AS3935,WATCHDOG,RANGE",
        fromPi
      );
    }
  }


  // ==========================================================
  // SET SPIKE REJECTION
  // ==========================================================

  else if (
    cmd.startsWith(
      "SET,AS3935,SPIKE="
    )
  )
  {
    int value =
      cmd.substring(
        strlen(
          "SET,AS3935,SPIKE="
        )
      ).toInt();


    if (
      value >= 0 &&
      value <= 15
    )
    {
      as3935Spike =
        (uint8_t)value;


      lightning.setSpikeRejection(
        as3935Spike
      );


      commandResponse(
        "ACK,AS3935,SPIKE=" +
        String(
          as3935Spike
        ),
        fromPi
      );
    }
    else
    {
      commandResponse(
        "ERR,AS3935,SPIKE,RANGE",
        fromPi
      );
    }
  }


  // ==========================================================
  // SHT31 HEATER ON
  // ==========================================================

  else if (
    cmd ==
    "SET,SHT31,HEATER=ON"
  )
  {
    if (sht31Online)
    {
      sht31.heater(
        true
      );


      sht31Heater =
        true;


      commandResponse(
        "ACK,SHT31,HEATER=ON",
        fromPi
      );
    }
    else
    {
      commandResponse(
        "ERR,SHT31,OFFLINE",
        fromPi
      );
    }
  }


  // ==========================================================
  // SHT31 HEATER OFF
  // ==========================================================

  else if (
    cmd ==
    "SET,SHT31,HEATER=OFF"
  )
  {
    if (sht31Online)
    {
      sht31.heater(
        false
      );


      sht31Heater =
        false;


      commandResponse(
        "ACK,SHT31,HEATER=OFF",
        fromPi
      );
    }
    else
    {
      commandResponse(
        "ERR,SHT31,OFFLINE",
        fromPi
      );
    }
  }


  // ==========================================================
  // TEST LIGHTNING
  // ==========================================================

  else if (
    cmd == "TEST LIGHTNING"
  )
  {
    Serial1.println(
      "LIGHTNING,DIST=12,ENERGY=123456"
    );


    if (!fromPi)
    {
      Serial.println(
        "TEST LIGHTNING sent to Pi."
      );
    }
  }


  // ==========================================================
  // TEST EMI
  // ==========================================================

  else if (
    cmd == "TEST EMI"
  )
  {
    Serial1.println(
      "EMI_EVENT"
    );


    if (!fromPi)
    {
      Serial.println(
        "TEST EMI sent to Pi."
      );
    }
  }


  // ==========================================================
  // TEST NOISE
  // ==========================================================

  else if (
    cmd == "TEST NOISE"
  )
  {
    Serial1.println(
      "NOISE"
    );


    if (!fromPi)
    {
      Serial.println(
        "TEST NOISE sent to Pi."
      );
    }
  }


  // ==========================================================
  // RESET COUNTERS
  // ==========================================================

  else if (
    cmd == "RESET COUNTERS" ||
    cmd == "RESET"
  )
  {
    lightningCount =
      0;


    emiEventCount =
      0;


    noiseCount =
      0;


    unknownIrqCount =
      0;


    commandResponse(
      "ACK,COUNTERS,RESET",
      fromPi
    );
  }


  // ==========================================================
  // HELP
  // ==========================================================

  else if (
    cmd == "HELP"
  )
  {
    if (!fromPi)
    {
      printHelp();
    }
    else
    {
      commandResponse(
        "ACK,HELP,USB_ONLY",
        true
      );
    }
  }


  // ==========================================================
  // UNKNOWN COMMAND
  // ==========================================================

  else
  {
    // USB:
    // Tell us what went wrong.
    //
    // Pi/D7:
    // Silently ignore unknown garbage.
    //
    // This prevents a noisy/floating/corrupt RX line from
    // polluting the normal Meteor data stream.

    if (!fromPi)
    {
      Serial.print(
        "ERR,UNKNOWN_COMMAND: "
      );


      Serial.println(
        cmd
      );
    }
  }
}


// ============================================================
// USB COMMAND READER
// ============================================================

void handleUSBCommands()
{
  while (
    Serial.available()
  )
  {
    char c =
      Serial.read();


    // --------------------------------------------------------
    // End of command
    // --------------------------------------------------------

    if (
      c == '\n' ||
      c == '\r'
    )
    {
      if (
        usbCommand.length() > 0
      )
      {
        processCommand(
          usbCommand,
          false
        );


        usbCommand =
          "";
      }


      continue;
    }


    // --------------------------------------------------------
    // Printable ASCII only
    // --------------------------------------------------------

    if (
      c >= 32 &&
      c <= 126
    )
    {
      usbCommand +=
        c;
    }


    // --------------------------------------------------------
    // Overflow protection
    // --------------------------------------------------------

    if (
      usbCommand.length() > 120
    )
    {
      usbCommand =
        "";


      Serial.println(
        "ERR,COMMAND_TOO_LONG"
      );
    }
  }
}


// ============================================================
// PI / D7 COMMAND READER
// ============================================================

void handlePiCommands()
{
  while (
    Serial1.available()
  )
  {
    char c =
      Serial1.read();


    // --------------------------------------------------------
    // Complete command
    // --------------------------------------------------------

    if (
      c == '\n' ||
      c == '\r'
    )
    {
      if (
        piCommand.length() > 0
      )
      {
        processCommand(
          piCommand,
          true
        );


        piCommand =
          "";
      }


      continue;
    }


    // --------------------------------------------------------
    // Printable ASCII only
    // --------------------------------------------------------

    if (
      c >= 32 &&
      c <= 126
    )
    {
      piCommand +=
        c;


      // ------------------------------------------------------
      // Maximum command length
      // ------------------------------------------------------

      if (
        piCommand.length() > 120
      )
      {
        // Silently discard garbage.
        piCommand =
          "";
      }
    }
    else
    {
      // Invalid UART byte.
      //
      // Discard partial packet and DO NOT respond.
      // This prevents garbage-response loops.

      piCommand =
        "";
    }
  }
}


// ============================================================
// SETUP
// ============================================================

void setup()
{
  // ==========================================================
  // USB DEBUG
  // ==========================================================

  Serial.begin(
    115200
  );


  // ==========================================================
  // PI UART
  //
  // XIAO:
  // D6 = TX
  // D7 = RX
  // ==========================================================

  Serial1.begin(
    9600
  );


  // Keep RX defined HIGH if Raspberry TX is not connected.
  //
  // UART idle state is HIGH.

  pinMode(
    PI_RX_PIN,
    INPUT_PULLUP
  );


  // ==========================================================
  // STARTUP DELAY
  // ==========================================================

  delay(
    1500
  );


  Serial.println();

  Serial.println(
    "================================="
  );

  Serial.println(
    " VIGILIS Outdoor Sensor Node"
  );

  Serial.println(
    " V2.1"
  );

  Serial.println(
    " XIAO SAMD21"
  );

  Serial.println(
    "================================="
  );


  Serial.println();

  Serial.println(
    "D6/TX -> Pi GPIO13 / Pin 33"
  );


  Serial.println(
    "D7/RX <- Pi GPIO26 / Pin 37"
  );


  Serial.println();


  // ==========================================================
  // I2C
  // ==========================================================

  Wire.begin();


  // ==========================================================
  // SHT31
  // ==========================================================

  Serial.print(
    "SHT31: "
  );


  if (
    sht31.begin(
      0x44
    )
  )
  {
    sht31Online =
      true;


    Serial.println(
      "OK"
    );


    Serial1.println(
      "STATUS,SHT31=ONLINE"
    );
  }
  else
  {
    sht31Online =
      false;


    Serial.println(
      "NOT FOUND"
    );


    Serial1.println(
      "STATUS,SHT31=OFFLINE"
    );
  }


  // ==========================================================
  // AS3935 COLD START FIX
  // ==========================================================

  Serial.println();


  Serial.print(
    "AS3935 power-up delay: "
  );


  Serial.print(
    AS3935_POWERUP_DELAY_MS
  );


  Serial.println(
    " ms"
  );


  delay(
    AS3935_POWERUP_DELAY_MS
  );


  // ==========================================================
  // INITIALIZE AS3935
  // ==========================================================

  initializeAS3935();


  // ==========================================================
  // NODE READY
  // ==========================================================

  Serial.println();

  Serial.println(
    "================================="
  );

  Serial.println(
    " VIGILIS Outdoor Node READY"
  );

  Serial.println(
    "================================="
  );


  Serial.println();

  Serial.println(
    "Type HELP for commands."
  );


  Serial.println();


  Serial1.println(
    "STATUS,NODE=READY"
  );
}


// ============================================================
// LOOP
// ============================================================

void loop()
{
  // ==========================================================
  // COMMAND INPUTS
  // ==========================================================

  handleUSBCommands();

  handlePiCommands();


  // ==========================================================
  // ENVIRONMENT DATA
  // ==========================================================

  if (
    millis() -
    lastEnvironmentSend
    >=
    ENV_INTERVAL
  )
  {
    lastEnvironmentSend =
      millis();


    sendEnvironment();
  }


  // ==========================================================
  // AS3935 EVENT
  // ==========================================================

  if (
    as3935Interrupt &&
    as3935Online
  )
  {
    as3935Interrupt =
      false;


    // Give interrupt source register time to settle.

    delay(5);


    uint8_t source =
      lightning.getInterruptSrc();


    Serial.println();

    Serial.println(
      ">>>>>>>> IRQ RECEIVED <<<<<<<<"
    );


    Serial.print(
      "Interrupt source: "
    );


    Serial.println(
      source
    );


    // ========================================================
    // LIGHTNING
    // ========================================================

    if (
      source == 1
    )
    {
      lightningCount++;


      uint8_t distance =
        lightning.getLightningDistKm();


      uint32_t energy =
        lightning.getStrikeEnergyRaw();


      Serial.println();

      Serial.println(
        "********************************"
      );


      Serial.println(
        "***     LIGHTNING DETECTED    ***"
      );


      Serial.println(
        "********************************"
      );


      Serial.print(
        "Distance: "
      );


      Serial.print(
        distance
      );


      Serial.println(
        " km"
      );


      Serial.print(
        "Energy: "
      );


      Serial.println(
        energy
      );


      Serial.print(
        "Lightning count: "
      );


      Serial.println(
        lightningCount
      );


      // ------------------------------------------------------
      // Send to Raspberry Pi
      // ------------------------------------------------------

      Serial1.print(
        "LIGHTNING,DIST="
      );


      Serial1.print(
        distance
      );


      Serial1.print(
        ",ENERGY="
      );


      Serial1.println(
        energy
      );
    }


    // ========================================================
    // EMI / DISTURBER
    // ========================================================

    else if (
      source == 2
    )
    {
      emiEventCount++;


      Serial.println();

      Serial.println(
        "*** EMI EVENT ***"
      );


      Serial.print(
        "EMI Event count: "
      );


      Serial.println(
        emiEventCount
      );


      Serial1.println(
        "EMI_EVENT"
      );
    }


    // ========================================================
    // NOISE
    // ========================================================

    else if (
      source == 3
    )
    {
      noiseCount++;


      Serial.println();

      Serial.println(
        "*** NOISE ***"
      );


      Serial.print(
        "Noise count: "
      );


      Serial.println(
        noiseCount
      );


      Serial1.println(
        "NOISE"
      );
    }


    // ========================================================
    // UNKNOWN / SOURCE 0
    // ========================================================

    else
    {
      unknownIrqCount++;


      Serial.println();

      Serial.println(
        "*** UNKNOWN IRQ ***"
      );


      Serial.print(
        "Raw source: "
      );


      Serial.println(
        source
      );


      Serial.print(
        "Unknown IRQ count: "
      );


      Serial.println(
        unknownIrqCount
      );
    }


    Serial.println();
  }
}
